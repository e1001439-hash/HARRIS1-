{
  "name": "harris-line-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/*.test.ts",
    "start": "node --use-env-proxy dist/main.js",
    "migrate": "node dist/migrate.js",
    "demo": "tsx src/demo.ts",
    "demo:send": "tsx src/demo-send.ts"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "openai": "7.43.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
