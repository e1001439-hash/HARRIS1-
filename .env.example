# 複製為未追蹤的 .env，或在部署平台的安全環境設定中填入。
# 不要把密鑰、真實 LINE user ID、資料庫連線字串貼到聊天或 Git。
NODE_ENV=development
PORT=3000

# 正式啟動需要持久化 PostgreSQL；本機 npm run demo 不需要。
DATABASE_URL=

# 必填的真實 LINE 設定：保留空白，請自行安全填入。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OWNER_LINE_USER_ID=

# 與店主不同的測試客人 user ID；多個以半形逗號分隔。
TEST_LINE_USER_IDS=
BOT_MODE=test
RESPONSE_MODE=fixed

# 只有 RESPONSE_MODE=ai 時需要；模型請填帳號已確認支援的名稱。
SALON_AI_API_KEY=
AI_MODEL=

KNOWLEDGE_PATH=knowledge/salon.md
BOOKING_URL=https://g7.zoom-world.tw/Round2HairSalon/index.aspx
PUBLIC_SITE_URL=https://harrishair.tw/
