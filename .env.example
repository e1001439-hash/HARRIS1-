# 複製為未追蹤的 .env，或在部署平台的安全環境設定中填入。
# 不要把密鑰、真實 LINE user ID、資料庫連線字串貼到聊天或 Git。
NODE_ENV=development
PORT=3000

# 最小啟動必填四欄之一：支援並驗證 TLS 的持久化 PostgreSQL 連線。
# 本機 npm run demo 使用假值與內嵌資料庫，不需要正式憑證。
DATABASE_URL=

# 其餘三個必填欄位：LINE 簽章密鑰、發訊憑證、店主本人識別碼。
# OWNER_LINE_USER_ID 由本人從 Harris channel 的 Your user ID 安全填入，不能填 @nsw7233k。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
OWNER_LINE_USER_ID=

# 選填的手動靜態測試名單，可省略或留空，不阻擋 test/fixed 啟動。
# 建議由店主透過 /配對 → /配對狀態 → /確認配對 P代號 加入指定的另一人。
# 若手動填入，多個 user ID 以半形逗號分隔，不能包含店主。
# /移除測試 只移除動態配對授權，不會改動此靜態名單。
TEST_LINE_USER_IDS=
# 測試模式與固定回覆：初啟動保留以下預設。
BOT_MODE=test
RESPONSE_MODE=fixed

# 只有 RESPONSE_MODE=ai 時需要；模型請填帳號已確認支援的名稱。
SALON_AI_API_KEY=
AI_MODEL=

# 儲存庫已附 salon.md 與同資料夾的 facts.json；不是新必填的人工輸入。
KNOWLEDGE_PATH=knowledge/salon.md
BOOKING_URL=https://harrishair.tw
PUBLIC_SITE_URL=https://harrishair.tw/
